# Backend environment variables
# Copy this to .env and set actual values

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
LOG_LEVEL=INFO

# Database
DATABASE_PATH=data/pricewatch.db

# Scraper Configuration
SCRAPER_ENABLED=false
SCRAPER_INTERVAL_HOURS=6
SCRAPER_MAX_RETRIES=3

# Logging
LOG_DIR=logs
